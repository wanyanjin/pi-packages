{
  "name": "@wanyanjin/pi-subagents-compat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Compatibility distribution of native pi-subagents and pi-subagents-worktrees with same-session workspace resume.",
  "license": "MIT",
  "workspaces": [
    "packages/pi-subagents",
    "packages/pi-subagents-worktrees"
  ],
  "dependencies": {
    "@gotgenes/pi-subagents": "*",
    "@gotgenes/pi-subagents-worktrees": "*"
  },
  "pi": {
    "extensions": [
      "./packages/pi-subagents/src/index.ts",
      "./packages/pi-subagents-worktrees/src/index.ts"
    ]
  },
  "engines": { "node": ">=22.18" }
}
